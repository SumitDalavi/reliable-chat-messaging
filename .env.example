# ==============================================================================
# Progressive Credential Loading (PCL) Configuration
# Repository: reliable-chat-messaging
# ==============================================================================
#
# TIER 1: ZERO-SETUP / LOCAL DEV / CI (Default)
# - In-memory message store and mock delivery receipts.
#
# TIER 2 / TIER 3: PRODUCTION DATABASE & REDIS PUB/SUB
# - Connect to managed database for message persistence.

DATABASE_URL=postgresql://user:pass@localhost:5432/chat_db
REDIS_URL=redis://localhost:6379
PORT=3000
